{
  "name": "lawlab",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/contractRules.test.ts tests/study.test.ts tests/paper.test.ts tests/research.test.ts tests/ai-analysis.test.ts tests/contractImport.test.ts tests/contractCore.test.ts tests/graphAndRiskLocation.test.ts tests/accessibilityUI.test.ts tests/artGraph.test.ts",
    "dev:worker": "wrangler dev",
    "deploy:worker": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pdfjs-dist": "^5.4.394",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.45.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
