{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lawlab",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-16",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}
