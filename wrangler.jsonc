{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lawlab",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-16",
  "ai": {
    "binding": "AI"
  },
  // Caps on Workers AI calls. Limits are approximate and per Cloudflare location; period is 10 or 60 seconds.
  "ratelimits": [
    { "name": "AI_IP_LIMITER", "namespace_id": "41001", "simple": { "limit": 4, "period": 60 } },
    { "name": "AI_GLOBAL_LIMITER", "namespace_id": "41002", "simple": { "limit": 20, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}
